# ==============================================================================
# EXOTICMORPH BACKEND CONFIGURATION
# ==============================================================================

# LLM Provider: 'openai' | 'gemini' | 'mock'
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS: chuỗi phân tách bởi dấu phẩy (hoặc JSON list).
# LƯU Ý: biến phải tên đúng là ALLOWED_ORIGINS — bản cũ ghi 'CORS_ORIGINS'
# nên bị pydantic bỏ qua lặng lẽ và CORS dùng giá trị mặc định!
# Đặt '*' để mở cho mọi domain (chỉ nên dùng khi debug).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
